# Copy to .env and fill in. Never commit the real .env.
SERVICE_API_KEY=choose-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# live = call Gemini | record = call and cache | replay = cache only (no network)
LLM_MODE=replay
PROMPT_VERSION=v1
DB_PATH=data/demo.db
QUERY_LOG_DB=data/query_log.db
