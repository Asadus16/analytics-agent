      "typeVersion": 2,
      "position": [
        -720,
        300
      ],
      "webhookId": "ask-analytics"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nreturn [{ json: { question: (b.question || '').trim() } }];"
      },
      "id": "93866f86-0cc9-4fbe-9939-f832fb6d9889",
      "name": "Normalize question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8098/plan",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.question }) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "demo-secret-key"
            }
          ]
        }
      },
      "id": "3104e267-69b7-48fe-935d-5557e5bf13b0",
      "name": "Plan: select metric (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.refused }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e44b4925-8c59-4d95-9e0f-9fc1be176b1d",
      "name": "Metric defined?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "refused",
              "value": "true",
              "type": "boolean"
            },
            {
              "id": "a1",
              "name": "reason",
              "value": "={{ $json.reason }}",
              "type": "string"
