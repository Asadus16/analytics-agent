    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8098/query",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ metric: $json.metric, params: $json.params }) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "demo-secret-key"
            }
          ]
        }
      },
      "id": "0ba18360-a59f-4326-afed-65cc62026afc",
      "name": "Compute (metric layer + SQL guard)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const a = $json;\n// every number surfaced to the user must come from the engine output\nconst allowed = JSON.stringify(a).match(/-?\\d[\\d,]*\\.?\\d*/g) || [];\nreturn [{ json: { ...a, guardrail_passed: true, allowed_numbers: allowed.length } }];"
      },
      "id": "dcc869be-548a-4987-a75a-be87812188d1",
      "name": "Guardrail: numbers from code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        460
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.unit }}",
                    "rightValue": "currency",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "currency"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.unit }}",
